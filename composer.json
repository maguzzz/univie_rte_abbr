{
	"name": "univie/rte-ckeditor-abbr",
	"type": "typo3-cms-extension",
	"description": "TYPO3 13 / CKEditor 5 fork of Studio Mitte rte_ckeditor_abbr: insert abbreviations in the rich-text editor.",
	"authors": [
		{
			"name": "Georg Ringer",
			"role": "Original developer"
		},
		{
			"name": "Wolfgang Höller",
			"role": "Original developer"
		},
		{
			"name": "Maguzzz",
			"role": "Maintainer (TYPO3 13 fork)"
		}
	],
	"license": [
		"GPL-2.0-or-later"
	],
	"require": {
		"typo3/cms-rte-ckeditor": "^12.4 || ^13.4"
	},
	"autoload": {
		"psr-4": {
			"Univie\\RteCkeditorAbbr\\": "Classes"
		}
	},
	"extra": {
